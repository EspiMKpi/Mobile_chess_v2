<?xml version="1.0" encoding="utf-8"?>
<!-- [HƯỚNG DẪN BƯỚC 5 - Dọn file cũ] Sau khi xóa ClientMainActivity.java, hãy XÓA luôn file layout này. -->
<!-- ClientMainActivity: nhập địa chỉ, cổng server rồi kết nối. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/txtServerHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="none"
        android:hint="@string/label_host"
        android:inputType="text"
        android:text="@string/default_host" />

    <EditText
        android:id="@+id/txtServerPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="none"
        android:hint="@string/label_port"
        android:inputType="number"
        android:text="@string/default_port" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_connect" />
</LinearLayout>
