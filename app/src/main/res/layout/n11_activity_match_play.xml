<?xml version="1.0" encoding="utf-8"?>
<!-- [PHẦN N11 THAY THẾ] Giao diện giả lập phòng đấu để N04 tự kiểm thử luồng bàn giao và quay về Lobby. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/lblMatchInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="24dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnSimulateResign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xin thua (giả lập kết thúc ván)" />

    <LinearLayout
        android:id="@+id/layoutContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/lblEndResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnContinueMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tiếp tục ván mới (đổi màu)" />

        <Button
            android:id="@+id/btnStopMatch"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dừng chơi (về danh sách online)" />
    </LinearLayout>
</LinearLayout>
