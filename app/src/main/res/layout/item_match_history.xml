<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Dòng 1: Mã trận & Thời gian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtMatchId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trận #1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/txtMatchTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03/11/2026 15:30"
                android:textSize="13sp"
                android:textColor="#777777" />
        </LinearLayout>

        <!-- Dòng 2: Thông tin đối thủ -->
        <TextView
            android:id="@+id/txtOpponentInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Đối thủ: Nguyễn Văn B (Quân ĐEN)"
            android:textSize="14sp"
            android:textColor="#444444" />

        <!-- Dòng 3: Kết quả của người chơi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtResultBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THẮNG"
                android:textStyle="bold"
                android:textSize="13sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#2E7D32"
                android:background="#E8F5E9" />

            <TextView
                android:id="@+id/txtMyColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="(Quân TRẮNG)"
                android:textSize="13sp"
                android:textColor="#666666" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
